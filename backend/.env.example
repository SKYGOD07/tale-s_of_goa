# ─────────────────────────────────────────────────────────────────────
# Tales of Goa — backend + blockchain configuration
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# ─────────────────────────────────────────────────────────────────────

PORT=8000
HOST=0.0.0.0

# ── Active chain ─────────────────────────────────────────────────────
# The backend talks to whatever BLOCKCHAIN_RPC_URL / CHAIN_ID point at.
#
#   Sepolia testnet : CHAIN_ID=11155111, RPC = your Sepolia endpoint
#   Local Hardhat   : CHAIN_ID=31337,    RPC = http://127.0.0.1:8545
#
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# Address printed by `npm run deploy:sepolia` in blockchain/
CONTRACT_ADDRESS=

# Key the backend signs recordVerification() transactions with.
# Use a THROWAWAY testnet account — it only ever needs Sepolia ETH.
PRIVATE_KEY=

# ── Hardhat deployment (blockchain/hardhat.config.js reads this file) ─
# A dedicated endpoint (Alchemy/Infura) is more reliable than the public
# one above for deployments; leave blank to reuse BLOCKCHAIN_RPC_URL.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer key. Falls back to PRIVATE_KEY when unset.
DEPLOYER_PRIVATE_KEY=

# Optional — only needed for `npx hardhat verify`
ETHERSCAN_API_KEY=
